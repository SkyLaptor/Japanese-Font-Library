          <file source="fontconfig/skyrim_normal.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/skyrim_normal.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_skyrim-jp-every_every.swf" destination="interface/fonts_skyrim-jp-every_every.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Skyrim" />
          <flagDependency flag="MainFontWidth" value="Condensed" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="fontconfig/skyrim_condensed.txt" destination="interface/fontconfig.txt" />
