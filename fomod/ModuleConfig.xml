<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Japanese Font Library</moduleName>
  <requiredInstallFiles>
    <file source="font/fonts_core.swf" destination="interface/fonts_core.swf" />
    <file source="fontconfig/fontconfig_ja_template.txt" destination="interface/fontconfig_template.txt" />
    <file source="fontconfig/fontconfig_ja_template.txt" destination="interface/fontconfig_ja_template.txt" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="">
      <optionalFileGroups order="Explicit">
        <group name="ゲームエディション" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="SkyrimSE">
              <description>Skyrim SE/AE/VR対して適用する場合はこちらを選択します。
当MODはSkyrimAE 日本語版 v1.6.1170にて検証されています。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="GameVersion">SkyrimSE</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="Skyrim">
              <description>Skyrim 無印/LEに対して適用する場合はこちらを選択します。
当MODはSkyrim 英語版 v1.9.32にて検証されています。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="GameVersion">Skyrim</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="バグ修正" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="本">
              <description>「アーヴェルの日記」や「エルトリスのメモ」等、一部の書籍に意図したフォントが適用されないバグを修正します。
他のUI系MODと競合が発生した場合は無効化して下さい。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Bugfix-Book">True</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="レベルアップダイアログ">
              <description>レベルアップ時のスキルメニューに表示されるダイアログにて、文字が表示されないバグ、文字が大きすぎる問題を修正します。
他のUI系MODと競合が発生した場合は無効化して下さい。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Bugfix-LevelupMenu">True</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="プリセット" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="カワイイ">
              <description>カワイイ系のフォントに置き換えます。
作者が実際に使用しているお勧めのプリセットです。

・全般フォント: にゃしいフォント改二
・本フォント: じゆうちょうフォント
・メモフォント: あんずもじ </description>
              <image path="fomod/preset_kawaii.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Kawaii</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="スカイリム">
              <description>日本語版Skyrimのデフォルトフォントを純粋に拡張したものに置き換えます。
字体はデフォルトが良いんだけど、MODで表示できない文字が豆腐になるのを防ぎたいという人向けです。

・汎用フォント: スカイリムJP-Every
・本フォント: スカイリムJP-Book
・メモフォント: スカイリムJP-Handwrite</description>
              <image path="fomod/preset_skyrim.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Skyrim</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="スムーズスカイリム">
              <description>日本語版Skyrimのデフォルトフォントのうち、メインフォントを視認性の良い似たフォントに置き換えます。

・汎用フォント: FuturaCondensed + Noto-Sans
・本フォント: スカイリムJP-Book
・メモフォント: スカイリムJP-Handwrite</description>
              <image path="fomod/preset_smoothskyrim.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">SmoothSkyrim</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="ロアフレンドリー">
              <description>Skyrim用MOD Lore-friendly fonts - font_jp_skyrim 移植拡張版です。

・汎用フォント: Lore-Friendly-Every
・本フォント: Lore-Friendly-Every
・メモフォント: Lore-Friendly-Handwrite</description>
              <image path="fomod/preset_lorefriendly.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">LoreFriendly</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="しねきゃぷしょん">
              <description>Skyrim用MOD JP Font Cinecaption の移植拡張版です。

・汎用フォント: しねきゃぷしょん
・本フォント: スカイリムJP-Book
・メモフォント: スカイリムJP-Handwrite</description>
              <image path="fomod/preset_cinecaption.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Cinecaption</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="モダン">
              <description>EdgeUIなどのモダンなUI向けのフォントに置き換えます。

・汎用フォント: MPLUS
・本フォント: スカイリムJP-Book
・メモフォント: スカイリムJP-Handwrite</description>
              <image path="fomod/preset_modern.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Modern</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="フォントカスタムモード">
              <description>フォントファイルは配置せず、カスタマイズ用のフォントコンフィグテンプレート(interface\fontconfig_template.txt)と必須ファイルのみ配置します。自身でカスタマイズする場合はこちらを選択して下さい。
カスタマイズ手順はGitHubを参照して下さい。https://github.com/SkyLaptor/Japanese-Font-Library

なお、以降のメインフォント幅、サブセット設定は本モードでは無効です。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Preset">Custom</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="プリセットのメインフォント幅" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="ノーマル">
              <description>通常のフォント幅です。</description>
              <image path="fomod/sample_normal.jpg" />
              <files />
              <conditionFlags>
                <flag name="MainFontWidth">Normal</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="コンデンスド">
              <description>フォント幅が通常比60-70%になります。
視認性とUIへの収まりのバランスが取れています。</description>
              <image path="fomod/sample_condensed.jpg" />
              <files />
              <conditionFlags>
                <flag name="MainFontWidth">Condensed</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="スキニー">
              <description>フォント幅が通常比40-50%になります。
視認性よりUIへの収まりを重要視する人向けです。</description>
              <image path="fomod/sample_skinny.jpg" />
              <files />
              <conditionFlags>
                <flag name="MainFontWidth">Skinny</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="サブセット" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="通常版">
              <description>JIS第四基準までを対象としたサブセットフォントを使用します。
注:JIS第四基準まで使用できることを保証するものではありません。</description>
              <files />
              <conditionFlags>
                <flag name="Subset">Normal</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="軽量版">
              <description>スカイリムにデフォルトで収録されている文字のみのサブセットフォントを使用します。
翻訳内容によっては文字が豆腐になります。TESVKanjiCheckerなどを使用して翻訳を確認して下さい。
通常版サブセットを使用してCTDが頻発するといった場合は、こちらの軽量版をお試し下さい。</description>
              <files />
              <conditionFlags>
                <flag name="Subset">Lightweight</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="その他オプション" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="SkyUI用MCM専用フォントマップ">
              <description>SkyUIのMCM画面が使用するフォントマップを変更するパッチです。他のUI系MODと競合が発生した場合は無効化して下さい。

使用するフォントマップを変更しますので、必ずfontconfig.txtに以下のフォントマップが適切に設定されていることを確認して下さい。
map "$MCMFont" = "フォント名" Normal
map "$MCMMediumFont" = "フォント名" Normal
map "$MCMBoldFont" = "フォント名" Normal</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Option-SkyUI-MCMSF">True</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
  <conditionalFileInstalls>
    <patterns>
      <!-- 本バグ修正 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="GameVersion" value="SkyrimSE" />
          <flagDependency flag="Bugfix-Book" value="True" />
        </dependencies>
        <files>
          <file source="bugfix/skyrimse-book.swf" destination="interface/book.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="GameVersion" value="Skyrim" />
          <flagDependency flag="Bugfix-Book" value="True" />
        </dependencies>
        <files>
          <file source="bugfix/skyrim-book.swf" destination="interface/book.swf" />
        </files>
      </pattern>
      <!-- レベルアップメニューバグ修正 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="GameVersion" value="SkyrimSE" />
          <flagDependency flag="Bugfix-LevelupMenu" value="True" />
        </dependencies>
        <files>
          <file source="bugfix/skyrimse-levelupmenu.swf" destination="interface/levelupmenu.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="GameVersion" value="Skyrim" />
          <flagDependency flag="Bugfix-LevelupMenu" value="True" />
        </dependencies>
        <files>
          <file source="bugfix/skyrim-levelupmenu.swf" destination="interface/levelupmenu.swf" />
        </files>
      </pattern>
      <!-- コンソールフォント（共通） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="font/fonts_hackgen-mono_bold_every.swf" destination="interface/fonts_hackgen-mono_bold_every.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Subset" value="Lightweight" />
        </dependencies>
        <files>
          <file source="font/fonts_hackgen-mono_bold_every_lightweight.swf" destination="interface/fonts_hackgen-mono_bold_every_lightweight.swf" />
        </files>
      </pattern>
      <!-- カワイイプリセット（通常版・共通） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="font/fonts_jiyucho_book.swf" destination="interface/fonts_jiyucho_book.swf" />
          <file source="font/fonts_apricot_handwrite.swf" destination="interface/fonts_apricot_handwrite.swf" />
        </files>
      </pattern>
      <!-- カワイイプリセット（通常版・通常幅） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="MainFontWidth" value="Normal" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="fontconfig/kawaii_normal.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/kawaii_normal.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_nyashi-kai2_every.swf" destination="interface/fonts_nyashi-kai2_every.swf" />
        </files>
      </pattern>
      <!-- カワイイプリセット（通常版・コンデンス） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="MainFontWidth" value="Condensed" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="fontconfig/kawaii_condensed.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/kawaii_condensed.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_nyashi-kai2_every_condensed.swf" destination="interface/fonts_nyashi-kai2_every_condensed.swf" />
        </files>
      </pattern>
      <!-- カワイイプリセット（通常版・スキニー） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="MainFontWidth" value="Skinny" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="fontconfig/kawaii_skinny.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/kawaii_skinny.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_nyashi-kai2_every_skinny.swf" destination="interface/fonts_nyashi-kai2_every_skinny.swf" />
        </files>
      </pattern>
      <!-- カワイイプリセット（軽量版・共通） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="Subset" value="Lightweight" />
        </dependencies>
        <files>
          <file source="font/fonts_jiyucho_book_lightweight.swf" destination="interface/fonts_jiyucho_book_lightweight.swf" />
          <file source="font/fonts_apricot_handwrite_lightweight.swf" destination="interface/fonts_apricot_handwrite_lightweight.swf" />
        </files>
      </pattern>
      <!-- カワイイプリセット（軽量版・通常幅） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="MainFontWidth" value="Normal" />
          <flagDependency flag="Subset" value="Lightweight" />
        </dependencies>
        <files>
          <file source="fontconfig/kawaii_normal_lightweight.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/kawaii_normal_lightweight.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_nyashi-kai2_every_lightweight.swf" destination="interface/fonts_nyashi-kai2_every_lightweight.swf" />
        </files>
      </pattern>
      <!-- カワイイプリセット（軽量版・コンデンス） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="MainFontWidth" value="Condensed" />
          <flagDependency flag="Subset" value="Lightweight" />
        </dependencies>
        <files>
          <file source="fontconfig/kawaii_condensed_lightweight.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/kawaii_condensed_lightweight.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_nyashi-kai2_every_condensed_lightweight.swf" destination="interface/fonts_nyashi-kai2_every_condensed_lightweight.swf" />
        </files>
      </pattern>
      <!-- カワイイプリセット（軽量版・スキニー） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="MainFontWidth" value="Skinny" />
          <flagDependency flag="Subset" value="Lightweight" />
        </dependencies>
        <files>
          <file source="fontconfig/kawaii_skinny_lightweight.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/kawaii_skinny_lightweight.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_nyashi-kai2_every_skinny_lightweight.swf" destination="interface/fonts_nyashi-kai2_every_skinny_lightweight.swf" />
        </files>
      </pattern>
      <!-- スカイリムプリセット（通常版・共通） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Skyrim" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="font/fonts_skyrim-jp-book_book.swf" destination="interface/fonts_skyrim-jp-book_book.swf" />
          <file source="font/fonts_skyrim-jp-handwrite_handwrite.swf" destination="interface/fonts_skyrim-jp-handwrite_handwrite.swf" />
        </files>
      </pattern>
      <!-- スカイリムプリセット（通常版・通常幅） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Skyrim" />
          <flagDependency flag="MainFontWidth" value="Normal" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="fontconfig/skyrim_normal.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/skyrim_normal.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_skyrim-jp-every_every.swf" destination="interface/fonts_skyrim-jp-every_every.swf" />
        </files>
      </pattern>
      <!-- スカイリムプリセット（通常版・コンデンス） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Skyrim" />
          <flagDependency flag="MainFontWidth" value="Condensed" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="fontconfig/skyrim_condensed.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/skyrim_condensed.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_skyrim-jp-every_every_condensed.swf" destination="interface/fonts_skyrim-jp-every_every_condensed.swf" />
        </files>
      </pattern>
      <!-- スカイリムプリセット（通常版・スキニー） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Skyrim" />
          <flagDependency flag="MainFontWidth" value="Skinny" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="fontconfig/skyrim_skinny.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/skyrim_skinny.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_skyrim-jp-every_every_skinny.swf" destination="interface/fonts_skyrim-jp-every_every_skinny.swf" />
        </files>
      </pattern>
      <!-- スカイリムプリセット（軽量版・共通） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Skyrim" />
          <flagDependency flag="Subset" value="Lightweight" />
        </dependencies>
        <files>
          <file source="font/fonts_skyrim-jp-book_book_lightweight.swf" destination="interface/fonts_skyrim-jp-book_book_lightweight.swf" />
          <file source="font/fonts_skyrim-jp-handwrite_handwrite_lightweight.swf" destination="interface/fonts_skyrim-jp-handwrite_handwrite_lightweight.swf" />
        </files>
      </pattern>
      <!-- スカイリムプリセット（軽量版・通常幅） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Skyrim" />
          <flagDependency flag="MainFontWidth" value="Normal" />
          <flagDependency flag="Subset" value="Lightweight" />
        </dependencies>
        <files>
          <file source="fontconfig/skyrim_normal_lightweight.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/skyrim_normal_lightweight.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_skyrim-jp-every_every_lightweight.swf" destination="interface/fonts_skyrim-jp-every_every_lightweight.swf" />
        </files>
      </pattern>
      <!-- スカイリムプリセット（軽量版・コンデンス） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Skyrim" />
          <flagDependency flag="MainFontWidth" value="Condensed" />
          <flagDependency flag="Subset" value="Lightweight" />
        </dependencies>
        <files>
          <file source="fontconfig/skyrim_condensed_lightweight.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/skyrim_condensed_lightweight.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_skyrim-jp-every_every_condensed_lightweight.swf" destination="interface/fonts_skyrim-jp-every_every_condensed_lightweight.swf" />
        </files>
      </pattern>
      <!-- スカイリムプリセット（軽量版・スキニー） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Skyrim" />
          <flagDependency flag="MainFontWidth" value="Skinny" />
          <flagDependency flag="Subset" value="Lightweight" />
        </dependencies>
        <files>
          <file source="fontconfig/skyrim_skinny_lightweight.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/skyrim_skinny_lightweight.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_skyrim-jp-every_every_skinny_lightweight.swf" destination="interface/fonts_skyrim-jp-every_every_skinny_lightweight.swf" />
        </files>
      </pattern>
      <!-- スムーズスカイリムプリセット（通常版・共通） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="SmoothSkyrim" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="font/fonts_skyrim-jp-book_book.swf" destination="interface/fonts_skyrim-jp-book_book.swf" />
          <file source="font/fonts_skyrim-jp-handwrite_handwrite.swf" destination="interface/fonts_skyrim-jp-handwrite_handwrite.swf" />
        </files>
      </pattern>
      <!-- スムーズスカイリムプリセット（通常版・通常幅） -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="SmoothSkyrim" />
          <flagDependency flag="MainFontWidth" value="Normal" />
          <flagDependency flag="Subset" value="Normal" />
