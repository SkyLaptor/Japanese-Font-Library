<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Japanese Font Library</moduleName>

  <!-- 必ず配置するファイル -->
  <requiredInstallFiles>
    <file source="data/fontswfs/fonts_core.swf" destination="interface/fonts_core.swf" />
  </requiredInstallFiles>

  <installSteps order="Explicit">
    <installStep name="">
      <optionalFileGroups order="Explicit">

        <!-- 対象とするゲーム選択 -->
        <group name="ゲームエディション" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="SkyrimSE">
              <description>Skyrim SE/AE/VR対して適用する場合はこちらを選択します。
当MODはSkyrimAE 日本語版 v1.6.1170にて検証されています。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="GameVersion">SkyrimSE</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="Skyrim">
              <description>Skyrim 無印/LEに対して適用する場合はこちらを選択します。
当MODはSkyrim 英語版 v1.9.32にて検証されています。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="GameVersion">Skyrim</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>

        <!-- 適用するバグフィクス選択 -->
        <group name="バグ修正" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="本">
              <description>「アーヴェルの日記」や「エルトリスのメモ」等、一部の書籍に意図したフォントが適用されないバグを修正します。
他のUI系MODと競合が発生した場合は無効化して下さい。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Bugfix-Book">True</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="レベルアップダイアログ">
              <description>レベルアップ時のスキルメニューに表示されるダイアログにて、文字が表示されないバグ、文字が大きすぎる問題を修正します。
他のUI系MODと競合が発生した場合は無効化して下さい。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Bugfix-LevelupMenu">True</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>

        <!-- プリセット選択 -->
        <group name="プリセット" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="カワイイ">
              <description>カワイイ系のフォントに置き換えます。
作者が実際に使用しているお勧めのプリセットです。

・全般フォント: にゃしいフォント改二
・本フォント: じゆうちょうフォント
・メモフォント: あんずもじ</description>
              <image path="assets/images/preset_kawaii.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Kawaii</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="スカイリム">
              <description>日本語版Skyrimのデフォルトフォントを純粋に拡張したものに置き換えます。
字体はデフォルトが良いんだけど、MODで表示できない文字が豆腐になるのを防ぎたいという人向けです。

・汎用フォント: スカイリムJP-Every
・本フォント: スカイリムJP-Book
・メモフォント: スカイリムJP-Handwrite</description>
              <image path="assets/images/preset_skyrim.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Skyrim</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="スムーズスカイリム">
              <description>日本語版Skyrimのデフォルトフォントのうち、メインフォントを視認性の良い似たフォントに置き換えます。

・汎用フォント: FuturaCondensed + Noto-Sans
・本フォント: スカイリムJP-Book
・メモフォント: スカイリムJP-Handwrite</description>
              <image path="assets/images/preset_smoothskyrim.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">SmoothSkyrim</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="ロアフレンドリー">
              <description>Skyrim用MOD「Lore-friendly fonts - font_jp_skyrim」の移植拡張版です。

・汎用フォント: Lore-Friendly-Every
・本フォント: Lore-Friendly-Every
・メモフォント: Lore-Friendly-Handwrite</description>
              <image path="assets/images/preset_lorefriendly.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">LoreFriendly</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="しねきゃぷしょん">
              <description>Skyrim用MOD「JP Font Cinecaption」の移植拡張版です。

・汎用フォント: しねきゃぷしょん
・本フォント: スカイリムJP-Book
・メモフォント: スカイリムJP-Handwrite</description>
              <image path="assets/images/preset_cinecaption.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Cinecaption</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="モダン">
              <description>EdgeUIなどのモダンなUI向けのフォントに置き換えます。

・汎用フォント: MPLUS
・本フォント: スカイリムJP-Book
・メモフォント: スカイリムJP-Handwrite</description>
              <image path="assets/images/preset_modern.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Modern</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="フォントカスタムモード">
              <description>フォントファイルは配置せず、カスタマイズ用のフォントコンフィグテンプレート(interface\fontconfig_template.txt)と必須ファイルのみ配置します。自身でカスタマイズする場合はこちらを選択して下さい。
カスタマイズ手順はGitHubを参照して下さい。https://github.com/SkyLaptor/Japanese-Font-Library

なお、以降のメインフォント幅、サブセット設定は本モードでは無効です。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Preset">Custom</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>

        <!-- 全般・UIフォント幅選択 -->
        <group name="プリセットの全般・UIフォント幅" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="100%幅">
              <description>インベントリや字幕に使用されるフォントの幅を通常の幅に指定します。</description>
              <image path="assets/images/sample_w100.png" />
              <files />
              <conditionFlags>
                <flag name="MainFontWidth">100</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="70%幅">
              <description>フォント幅が通常比70%になります。
視認性とUIへの収まりのバランスが取れています。</description>
              <image path="assets/images/sample_w70.png" />
              <files />
              <conditionFlags>
                <flag name="MainFontWidth">70</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="50%幅">
              <description>フォント幅が通常比50%になります。
視認性よりUIへの収まりを重要視する人向けです。</description>
              <image path="assets/images/sample_w50.png" />
              <files />
              <conditionFlags>
                <flag name="MainFontWidth">50</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>

        <!-- サブセット幅選択 -->
        <group name="サブセット" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="通常サブセット">
              <description>スカイリム収録文字、JIS第二基準文字、一部追加文字が担保されているサブセットを使用します。</description>
              <files />
              <conditionFlags>
                <flag name="Subset">Normal</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="軽量サブセット">
              <description>スカイリム収録文字のみのサブセットフォントを使用します。
翻訳内容によっては一部の文字が豆腐（□）になります。TESVKanjiCheckerなどを使用して事前に翻訳を確認して下さい。
通常サブセットを使用してCTDが頻発するといった場合は、こちらの軽量サブセットをお試し下さい。</description>
              <files />
              <conditionFlags>
                <flag name="Subset">Lightweight</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>

        <!-- その他 -->
        <group name="その他オプション" type="SelectAny">
          <plugins order="Explicit">

            <!-- MCM用フォントマップ -->
            <plugin name="SkyUI用MCM専用フォントマップ">
              <description>SkyUIのMCM画面が使用するフォントマップを変更するパッチです。他のUI系MODと競合が発生した場合は無効化して下さい。

MCMが使用するフォントマップを変更しますので、必ずfontconfig.txtに以下のフォントマップが適切に設定されていることを確認して下さい。
map "$MCMFont" = "フォント名" Normal
map "$MCMMediumFont" = "フォント名" Normal
map "$MCMBoldFont" = "フォント名" Normal

当インストーラーで設置されるfontconfig.txtには50%幅フォントが設定済みです。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Option-SkyUI-MCMSF">True</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>

  <!-- フラグによるファイル配置分岐 -->
  <conditionalFileInstalls>
    <patterns>

      <!-- 本バグ修正 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="GameVersion" value="SkyrimSE" />
          <flagDependency flag="Bugfix-Book" value="True" />
        </dependencies>
        <files>
          <file source="data/bugfixes/skyrimse-book.swf" destination="interface/book.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="GameVersion" value="Skyrim" />
          <flagDependency flag="Bugfix-Book" value="True" />
        </dependencies>
        <files>
          <file source="data/bugfixes/skyrim-book.swf" destination="interface/book.swf" />
        </files>
      </pattern>

      <!-- レベルアップメニューバグ修正 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="GameVersion" value="SkyrimSE" />
          <flagDependency flag="Bugfix-LevelupMenu" value="True" />
        </dependencies>
        <files>
          <file source="data/bugfixes/skyrimse-levelupmenu.swf" destination="interface/levelupmenu.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="GameVersion" value="Skyrim" />
          <flagDependency flag="Bugfix-LevelupMenu" value="True" />
        </dependencies>
        <files>
          <file source="data/bugfixes/skyrim-levelupmenu.swf" destination="interface/levelupmenu.swf" />
        </files>
      </pattern>

      <!-- カワイイプリセット-->
      <!-- 通常サブセット -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="data/fontswfs/fonts_kawaii_preset.swf" destination="interface/fonts_kawaii_preset.swf" />
        </files>
      </pattern>
      <!-- 軽量サブセット -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="Subset" value="Lightweight" />
        </dependencies>
        <files>
          <!-- 通常サブセットと同名でswfを配置することで、fontconfig.txtの数を削減（swf内の名前は通常版/サブセット版で同一にしておくこと。） -->
          <file source="data/fontswfs/fonts_kawaii_preset_lw.swf" destination="interface/fonts_kawaii_preset.swf" />
        </files>
      </pattern>
      <!-- 100%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="MainFontWidth" value="100" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/kawaii_w100.txt" destination="interface/fontconfig.txt" />
          <!-- SkyrimSE/AE/VR 日本語版v1.6以降は、fontconfig_ja.txtをデフォルトで読むようになっている。 -->
          <file source="data/fontconfigs/kawaii_w100.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>
      <!-- 70%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="MainFontWidth" value="70" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/kawaii_w70.txt" destination="interface/fontconfig.txt" />
          <file source="data/fontconfigs/kawaii_w70.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>
      <!-- 50%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="MainFontWidth" value="50" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/kawaii_w50.txt" destination="interface/fontconfig.txt" />
          <file source="data/fontconfigs/kawaii_w50.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>

      <!-- スカイリムプリセット -->
      <!-- 通常サブセット -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Skyrim" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="data/fontswfs/fonts_skyrim_preset.swf" destination="interface/fonts_skyrim_preset.swf" />
        </files>
      </pattern>
      <!-- 軽量サブセット -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Skyrim" />
          <flagDependency flag="Subset" value="Lightweight" />
        </dependencies>
        <files>
          <file source="data/fontswfs/fonts_skyrim_preset_lw.swf" destination="interface/fonts_skyrim_preset.swf" />
        </files>
      </pattern>
      <!-- 100%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Skyrim" />
          <flagDependency flag="MainFontWidth" value="100" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/skyrim_w100.txt" destination="interface/fontconfig.txt" />
          <file source="data/fontconfigs/skyrim_w100.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>
      <!-- 70%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Skyrim" />
          <flagDependency flag="MainFontWidth" value="70" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/skyrim_w70.txt" destination="interface/fontconfig.txt" />
          <file source="data/fontconfigs/skyrim_w70.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>
      <!-- 50%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Skyrim" />
          <flagDependency flag="MainFontWidth" value="50" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/skyrim_w50.txt" destination="interface/fontconfig.txt" />
          <file source="data/fontconfigs/skyrim_w50.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>

      <!-- スムーズスカイリムプリセット -->
      <!-- 通常サブセット -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="SmoothSkyrim" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="data/fontswfs/fonts_smoothskyrim_preset.swf" destination="interface/fonts_smoothskyrim_preset.swf" />
        </files>
      </pattern>
      <!-- 軽量サブセット -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="SmoothSkyrim" />
          <flagDependency flag="Subset" value="Lightweight" />
        </dependencies>
        <files>
          <file source="data/fontswfs/fonts_smoothskyrim_preset_lw.swf" destination="interface/fonts_smoothskyrim_preset.swf" />
        </files>
      </pattern>
      <!-- 100%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="SmoothSkyrim" />
          <flagDependency flag="MainFontWidth" value="100" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/smoothskyrim_w100.txt" destination="interface/fontconfig.txt" />
          <file source="data/fontconfigs/smoothskyrim_w100.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>
      <!-- 70%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="SmoothSkyrim" />
          <flagDependency flag="MainFontWidth" value="70" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/smoothskyrim_w70.txt" destination="interface/fontconfig.txt" />
          <file source="data/fontconfigs/smoothskyrim_w70.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>
      <!-- 50%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="SmoothSkyrim" />
          <flagDependency flag="MainFontWidth" value="50" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/smoothskyrim_w50.txt" destination="interface/fontconfig.txt" />
          <file source="data/fontconfigs/smoothskyrim_w50.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>

      <!-- ロアフレンドリープリセット -->
      <!-- 通常サブセット -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="LoreFriendly" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="data/fontswfs/fonts_lorefriendly_preset.swf" destination="interface/fonts_lorefriendly_preset.swf" />
        </files>
      </pattern>
      <!-- 軽量サブセット -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="LoreFriendly" />
          <flagDependency flag="Subset" value="Lightweight" />
        </dependencies>
        <files>
          <file source="data/fontswfs/fonts_lorefriendly_preset_lw.swf" destination="interface/fonts_lorefriendly_preset.swf" />
        </files>
      </pattern>
      <!-- 100%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="LoreFriendly" />
          <flagDependency flag="MainFontWidth" value="100" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/lorefriendly_w100.txt" destination="interface/fontconfig.txt" />
          <file source="data/fontconfigs/lorefriendly_w100.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>
      <!-- 70%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="LoreFriendly" />
          <flagDependency flag="MainFontWidth" value="70" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/lorefriendly_w70.txt" destination="interface/fontconfig.txt" />
          <file source="data/fontconfigs/lorefriendly_w70.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>
      <!-- 50%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="LoreFriendly" />
          <flagDependency flag="MainFontWidth" value="50" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/lorefriendly_w50.txt" destination="interface/fontconfig.txt" />
          <file source="data/fontconfigs/lorefriendly_w50.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>

      <!-- しねきゃぷしょんプリセット -->
      <!-- 通常サブセット -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Cinecaption" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="data/fontswfs/fonts_cinecaption_preset.swf" destination="interface/fonts_cinecaption_preset.swf" />
        </files>
      </pattern>
      <!-- 軽量サブセット -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Cinecaption" />
          <flagDependency flag="Subset" value="Lightweight" />
        </dependencies>
        <files>
          <file source="data/fontswfs/fonts_cinecaption_preset_lw.swf" destination="interface/fonts_cinecaption_preset.swf" />
        </files>
      </pattern>
      <!-- 100%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Cinecaption" />
          <flagDependency flag="MainFontWidth" value="100" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/cinecaption_w100.txt" destination="interface/fontconfig.txt" />
          <file source="data/fontconfigs/cinecaption_w100.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>
      <!-- 70%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Cinecaption" />
          <flagDependency flag="MainFontWidth" value="70" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/cinecaption_w70.txt" destination="interface/fontconfig.txt" />
          <file source="data/fontconfigs/cinecaption_w70.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>
      <!-- 50%幅 -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Cinecaption" />
          <flagDependency flag="MainFontWidth" value="50" />
        </dependencies>
        <files>
          <file source="data/fontconfigs/cinecaption_w50.txt" destination="interface/fontconfig.txt" />
          <file source="data/fontconfigs/cinecaption_w50.txt" destination="interface/fontconfig_ja.txt" />
        </files>
      </pattern>

      <!-- モダンプリセット -->
      <!-- 通常サブセット -->
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Modern" />
          <flagDependency flag="Subset" value="Normal" />
        </dependencies>
        <files>
          <file source="data/fontswfs/fonts_modern_preset.swf" destination="interface/fonts_modern_preset.swf" />
        </files>
      </pattern>
      <!-- 軽量サブセット -->
      <pattern>
        <dependencies operator="And">
