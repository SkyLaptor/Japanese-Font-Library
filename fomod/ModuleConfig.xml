<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Japanese Font Library</moduleName>
  <requiredInstallFiles>
    <file source="font/fonts_core.swf" destination="interface/fonts_core.swf" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="">
      <optionalFileGroups order="Explicit">
        <group name="ゲームエディション" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="SkyrimSE">
              <description>Skyrim SE/AE/VR対して適用する場合はこちらを選択します。
当MODはSkyrimAE v1.6.1170にて検証されています。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="GameVersion">SkyrimSE</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="Skyrim">
              <description>Skyrim、Skyrim＋各種DLC、SkyrimLEの所謂Oldrimに対して適用する場合はこちらを選択します。
当MODはSkyrim v1.9.32にて検証されています。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="GameVersion">Skyrim</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="バグ修正" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="本">
              <description>「アーヴェルの日記」や「エルトリスのメモ」等、一部の書籍に意図したフォントが適用されないバグを修正します。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Bugfix-Book">True</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="レベルアップダイアログ">
              <description>レベルアップ時のスキルメニューに表示されるダイアログにて、文字が表示されないバグを修正します。
また、文字を小さく表示して見切れないようにもします。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Bugfix-LevelupMenu">True</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="プリセット" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="カワイイ">
              <description>カワイイ系のフォントに置き換えます。
作者が実際に使用しているお勧めのプリセットです。

・全般フォント: にゃしいフォント改二
・本フォント: じゆうちょうフォント
・メモフォント: あんずもじ </description>
              <image path="fomod/preset_kawaii.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Kawaii</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="スカイリム">
              <description>日本語版Skyrimのデフォルトフォントを純粋に拡張したものに置き換えます。
字体はデフォルトが良いんだけど、MODで表示できない文字が豆腐になるのを防ぎたいという人向けです。

・汎用フォント: スカイリムJP-Every
・本フォント: スカイリムJP-Book
・メモフォント: スカイリムJP-Handwrite</description>
              <image path="fomod/preset_skyrim.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Skyrim</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="ロアフレンドリー">
              <description>Skyrim用MOD Lore-friendly fonts - font_jp_skyrim 移植拡張版です。

・汎用フォント: Lore-Feidndly-Every
・本フォント: Lore-Feidndly-Every
・メモフォント: Lore-Feidndly-Handwrite</description>
              <image path="fomod/preset_lorefriendly.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">LoreFriendly</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="しねきゃぷしょん">
              <description>Skyrim用MOD JP Font Cinecaption の移植拡張版です。

・汎用フォント: しねきゃぷしょん
・本フォント: スカイリムJP-Book
・メモフォント: スカイリムJP-Handwrite</description>
              <image path="fomod/preset_cinecaption.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Cinecaption</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="モダン">
              <description>EdgeUIなどのモダンなUI向けのフォントに置き換えます。

・汎用フォント: MPLUS
・本フォント: スカイリムJP-Book
・メモフォント: スカイリムJP-Handwrite</description>
              <image path="fomod/preset_modern.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Modern</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="フォントカスタムモード">
              <description>プリセットを導入しません。自身でカスタマイズする場合はこちらを選択して下さい。
カスタマイズ手順はGitHubを参照して下さい。https://github.com/SkyLaptor/Japanese-Font-Library</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Preset">None</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="プリセットのメインフォント幅" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="ノーマル">
              <description>通常のフォント幅です。</description>
              <image path="fomod/sample_normal.jpg" />
              <files />
              <conditionFlags>
                <flag name="MainFontWidth">Normal</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="コンデンスド">
              <description>通常のフォント幅と比べて60-70%の幅となります。
視認性とUIへの収まりのバランスが取れています。</description>
              <image path="fomod/sample_condensed.jpg" />
              <files />
              <conditionFlags>
                <flag name="MainFontWidth">Condensed</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="スキニー">
              <description>通常のフォント幅と比べて40-50%の幅となります。
視認性を犠牲にUIへの収まりを最重要視している人向けです。</description>
              <image path="fomod/sample_skinny.jpg" />
              <files />
              <conditionFlags>
                <flag name="MainFontWidth">Skinny</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="サブセット" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="通常版">
              <description>JIS第四基準までを対象としたサブセットフォントを使用します。
注:JIS第四基準まで使用できることを保証するものではありません。</description>
              <files />
              <conditionFlags>
                <flag name="Subset">Normal</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="軽量版">
              <description>スカイリムにデフォルトで収録されている文字のみのサブセットフォントを使用します。
翻訳内容によっては文字が豆腐になります。TESVKanjiCheckerなどを使用して翻訳を確認して下さい。
このフォントを入れたことでCTDが頻発する場合はこちらをお試し下さい。</description>
              <files />
              <conditionFlags>
                <flag name="Subset">Lightweight</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="オプション" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="SkyUI用MCM専用フォントマップ">
              <description>強く非推奨です。MCM画面が狭くて日本語だと見切れて困っているという場合にはWider MCMを使用したほうが幸せになれます。
「Nordic UI」や「Edge UI」といったUIオーバーホール系を導入している場合はMCM画面も全画面のものに置き換わっているはずですし、当MODで上書きするとUIがバニラに戻ってしまうため、有効にしないで下さい。

SkyUI 5.2SE(SkyrimSE用)またはSkyUI 5.1(Skyrim用)のMCMメニューを、専用のフォントマップを使用するものに置換します。
あくまで専用のフォントマップを使用するようにするだけであるため、fontconfig.txtに以下のフォントマップを追加した上で幅の狭いフォントを割り当てるという手間が発生します。（正しく割り当てなかった場合、MCM全体が豆腐化します。）
map "$MCMFont" = "フォント名" Normal
map "$MCMMediumFont" = "フォント名" Normal
map "$MCMBoldFont" = "フォント名" Normal</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Option-SkyUI-MCMSF">True</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
