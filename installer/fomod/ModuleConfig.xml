<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>Japanese Font Library</moduleName>
  <requiredInstallFiles>
    <file source="font/fonts_core.swf" destination="interface/fonts_core.swf" />
    <file source="font/fonts_hackgen_bold_every.swf" destination="interface/fonts_hackgen_bold_every.swf" />
  </requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="">
      <optionalFileGroups order="Explicit">
        <group name="ゲームエディション" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="SkyrimSE">
              <description>Skyrim SEおよびAEに対して適用する場合はこちらを選択します。作者は所有していないため検証はできていませんが、Skyrim VRでも動作するとのことです。
当MODはSkyrimAE v1.6.1170にて検証されています。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="GameVersion">SkyrimSE</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="Skyrim">
              <description>Skyrim、Skyrim＋各種DLC、SkyrimLEの所謂Oldrimに対して適用する場合はこちらを選択します。
当MODはSkyrim v1.9.32にて検証されています。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="GameVersion">Skyrim</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="バグ修正" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="本">
              <description>「アーヴェルの日記」や「エルトリスのメモ」等、一部の書籍に意図したフォントが適用されないバグを修正します。
「Nordic UI」や「Edge UI」といったUIオーバーホール系を導入している場合はオーバーホールMOD側でバグは修正されていますし、当MODで上書きするとUIがバニラに戻ってしまうため、有効にしないで下さい。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Bugfix-Book">True</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="レベルアップダイアログ">
              <description>レベルアップ時のスキルメニューに表示されるダイアログにて、文字が表示されないバグを修正します。
また、文字を小さく表示して見切れないようにもします。
「Nordic UI」や「Edge UI」といったUIオーバーホール系を導入している場合はオーバーホールMOD側でバグは修正されていますし、当MODで上書きするとUIがバニラｎい戻ってしまうため、有効にしないで下さい。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Bugfix-LevelupMenu">True</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="プリセット" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="カワイイ">
              <description>カワイイ系のフォントに置き換えます。
作者が実際に使用しているお勧めのプリセットです。

・汎用フォント: にゃしいフォント改二
・本フォント: じゆうちょうフォント
・メモフォント: あんずもじ </description>
              <image path="fomod/preset_kawaii.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Kawaii</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="バニライク">
              <description>日本語版Skyrimのデフォルトフォントに可能な限り似せたものに置き換えます。
字体はデフォルトが良いんだけど、MODで表示できない文字が豆腐になるのを防ぎたいという人向けです。

・汎用フォント: バニライク-Every
・本フォント: バニライク-Book
・メモフォント: バニライク-Handwrite</description>
              <image path="fomod/preset_vanilike.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Vanilike</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="ロアフレンドリー">
              <description>Skyrim用MOD Lore-friendly fonts - font_jp_skyrim 移植拡張版です。

・汎用フォント: Lore-Feidndlyメインフォント
・本フォント: Lore-Feidndlyメインフォント
・メモフォント: Lore-Feidndlyメモ向けフォント</description>
              <image path="fomod/preset_lorefriendly.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">LoreFriendly</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="しねきゃぷしょん">
              <description>Skyrim用MOD JP Font Cinecaption の移植拡張版です。

・汎用フォント: しねきゃぷしょん
・本フォント: バニライク-Book
・メモフォント: バニライク-Handwrite</description>
              <image path="fomod/preset_cinecaption.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Cinecaption</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="モダン">
              <description>EdgeUIなどのモダンなUI向けのフォントに置き換えます。

・汎用フォント: MPLUS-Every
・本フォント: バニライク-Book
・メモフォント: バニライク-Handwrite</description>
              <image path="fomod/preset_modern.jpg" />
              <files />
              <conditionFlags>
                <flag name="Preset">Modern</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="不要">
              <description>プリセットを導入しません。自身でカスタマイズする場合はこちらを選択して下さい。（このインストーラーでカスタマイズできるわけではありません。）
いきなり選択せず、慣れないうちは一度適当なプリセットを導入し、どのように構成すれば良いか雰囲気を掴んでから手を付けることをお勧めします。</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Preset">None</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="プリセットのメインフォント幅" type="SelectExactlyOne">
          <plugins order="Explicit">
            <plugin name="ノーマル">
              <description>通常幅です。</description>
              <image path="fomod/sample_normal.jpg" />
              <files />
              <conditionFlags>
                <flag name="MainFontWidth">Normal</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="コンデンスド">
              <description>通常比75%幅です。</description>
              <image path="fomod/sample_condensed.jpg" />
              <files />
              <conditionFlags>
                <flag name="MainFontWidth">Condensed</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
            <plugin name="スキニー">
              <description>通常比50%幅です。</description>
              <image path="fomod/sample_skinny.jpg" />
              <files />
              <conditionFlags>
                <flag name="MainFontWidth">Skinny</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
        <group name="オプション" type="SelectAny">
          <plugins order="Explicit">
            <plugin name="SkyUI用MCM専用フォントマップ">
              <description>強く非推奨です。MCM画面が狭くて日本語だと見切れて困っているという場合にはWider MCMを使用したほうが幸せになれます。
「Nordic UI」や「Edge UI」といったUIオーバーホール系を導入している場合はMCM画面も全画面のものに置き換わっているはずですし、当MODで上書きするとUIがバニラに戻ってしまうため、有効にしないで下さい。

SkyUI 5.2SE(SkyrimSE用)またはSkyUI 5.1(Skyrim用)のMCMメニューを、専用のフォントマップを使用するものに置換します。
あくまで専用のフォントマップを使用するようにするだけであるため、fontconfig.txtに以下のフォントマップを追加した上で幅の狭いフォントを割り当てるという手間が発生します。（正しく割り当てなかった場合、MCM全体が豆腐化します。）
map "$MCMFont" = "フォント名" Normal
map "$MCMMediumFont" = "フォント名" Normal
map "$MCMBoldFont" = "フォント名" Normal</description>
              <image path="" />
              <files />
              <conditionFlags>
                <flag name="Option-SkyUI-MCMSF">True</flag>
              </conditionFlags>
              <typeDescriptor>
                <type name="Optional" />
              </typeDescriptor>
            </plugin>
          </plugins>
        </group>
      </optionalFileGroups>
    </installStep>
  </installSteps>
  <conditionalFileInstalls>
    <patterns>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="GameVersion" value="SkyrimSE" />
          <flagDependency flag="Bugfix-Book" value="True" />
        </dependencies>
        <files>
          <file source="bugfix/skyrimse-book.swf" destination="interface/book.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="GameVersion" value="Skyrim" />
          <flagDependency flag="Bugfix-Book" value="True" />
        </dependencies>
        <files>
          <file source="bugfix/skyrim-book.swf" destination="interface/book.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="GameVersion" value="SkyrimSE" />
          <flagDependency flag="Bugfix-LevelupMenu" value="True" />
        </dependencies>
        <files>
          <file source="bugfix/skyrimse-levelupmenu.swf" destination="interface/levelupmenu.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="GameVersion" value="Skyrim" />
          <flagDependency flag="Bugfix-LevelupMenu" value="True" />
        </dependencies>
        <files>
          <file source="bugfix/skyrim-levelupmenu.swf" destination="interface/levelupmenu.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
        </dependencies>
        <files>
          <file source="font/fonts_jiyucho_book.swf" destination="interface/fonts_jiyucho_book.swf" />
          <file source="font/fonts_apricot_handwrite.swf" destination="interface/fonts_apricot_handwrite.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="MainFontWidth" value="Normal" />
        </dependencies>
        <files>
          <file source="fontconfig/kawaii_normal.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/kawaii_normal.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_nyashi-kai2_every.swf" destination="interface/fonts_nyashi-kai2_every.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="MainFontWidth" value="Condensed" />
        </dependencies>
        <files>
          <file source="fontconfig/kawaii_condensed.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/kawaii_condensed.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_nyashi-kai2_every_condensed.swf" destination="interface/fonts_nyashi-kai2_every_condensed.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Kawaii" />
          <flagDependency flag="MainFontWidth" value="Skinny" />
        </dependencies>
        <files>
          <file source="fontconfig/kawaii_skinny.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/kawaii_skinny.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_nyashi-kai2_every_skinny.swf" destination="interface/fonts_nyashi-kai2_every_skinny.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Vanilike" />
        </dependencies>
        <files>
          <file source="font/fonts_vanilike-book_book.swf" destination="interface/fonts_vanilike-book_book.swf" />
          <file source="font/fonts_vanilike-handwrite_handwrite.swf" destination="interface/fonts_vanilike-handwrite_handwrite.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Vanilike" />
          <flagDependency flag="MainFontWidth" value="Normal" />
        </dependencies>
        <files>
          <file source="fontconfig/vanilike_normal.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/vanilike_normal.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_vanilike-every_every.swf" destination="interface/fonts_vanilike-every_every.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Vanilike" />
          <flagDependency flag="MainFontWidth" value="Condensed" />
        </dependencies>
        <files>
          <file source="fontconfig/vanilike_condensed.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/vanilike_condensed.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_vanilike-every_every_condensed.swf" destination="interface/fonts_vanilike-every_every_condensed.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Vanilike" />
          <flagDependency flag="MainFontWidth" value="Skinny" />
        </dependencies>
        <files>
          <file source="fontconfig/vanilike_skinny.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/vanilike_skinny.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_vanilike-every_every_skinny.swf" destination="interface/fonts_vanilike-every_every_skinny.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="LoreFriendly" />
        </dependencies>
        <files>
          <file source="font/fonts_lore-friendly-n_book.swf" destination="interface/fonts_lore-friendly-n_book.swf" />
          <file source="font/fonts_lore-friendly-n2_handwrite.swf" destination="interface/fonts_lore-friendly-n2_handwrite.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="LoreFriendly" />
          <flagDependency flag="MainFontWidth" value="Normal" />
        </dependencies>
        <files>
          <file source="fontconfig/lorefriendly_normal.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/lorefriendly_normal.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_lore-friendly-n_every.swf" destination="interface/fonts_lore-friendly-n_every.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="LoreFriendly" />
          <flagDependency flag="MainFontWidth" value="Condensed" />
        </dependencies>
        <files>
          <file source="fontconfig/lorefriendly_condensed.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/lorefriendly_condensed.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_lore-friendly-n_every_condensed.swf" destination="interface/fonts_lore-friendly-n_every_condensed.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="LoreFriendly" />
          <flagDependency flag="MainFontWidth" value="Skinny" />
        </dependencies>
        <files>
          <file source="fontconfig/lorefriendly_skinny.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/lorefriendly_skinny.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_lore-friendly-n_every_skinny.swf" destination="interface/fonts_lore-friendly-n_every_skinny.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Cinecaption" />
        </dependencies>
        <files>
          <file source="font/fonts_vanilike-book_book.swf" destination="interface/fonts_vanilike-book_book.swf" />
          <file source="font/fonts_vanilike-handwrite_handwrite.swf" destination="interface/fonts_vanilike-handwrite_handwrite.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Cinecaption" />
          <flagDependency flag="MainFontWidth" value="Normal" />
        </dependencies>
        <files>
          <file source="fontconfig/cinecaption_normal.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/cinecaption_normal.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_cinecaption_every.swf" destination="interface/fonts_cinecaption_every.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Cinecaption" />
          <flagDependency flag="MainFontWidth" value="Condensed" />
        </dependencies>
        <files>
          <file source="fontconfig/cinecaption_condensed.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/cinecaption_condensed.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_cinecaption_every_condensed.swf" destination="interface/fonts_cinecaption_every_condensed.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Cinecaption" />
          <flagDependency flag="MainFontWidth" value="Skinny" />
        </dependencies>
        <files>
          <file source="fontconfig/cinecaption_skinny.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/cinecaption_skinny.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_cinecaption_every_skinny.swf" destination="interface/fonts_cinecaption_every_skinny.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Modern" />
        </dependencies>
        <files>
          <file source="font/fonts_vanilike-book_book.swf" destination="interface/fonts_vanilike-book_book.swf" />
          <file source="font/fonts_vanilike-handwrite_handwrite.swf" destination="interface/fonts_vanilike-handwrite_handwrite.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Modern" />
          <flagDependency flag="MainFontWidth" value="Normal" />
        </dependencies>
        <files>
          <file source="fontconfig/modern_normal.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/modern_normal.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_mplus_every.swf" destination="interface/fonts_mplus_every.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Modern" />
          <flagDependency flag="MainFontWidth" value="Condensed" />
        </dependencies>
        <files>
          <file source="fontconfig/modern_condensed.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/modern_condensed.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_mplus_every_condensed.swf" destination="interface/fonts_mplus_every_condensed.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="Preset" value="Modern" />
          <flagDependency flag="MainFontWidth" value="Skinny" />
        </dependencies>
        <files>
          <file source="fontconfig/modern_skinny.txt" destination="interface/fontconfig.txt" />
          <file source="fontconfig/modern_skinny.txt" destination="interface/fontconfig_ja.txt" />
          <file source="font/fonts_mplus_every_skinny.swf" destination="interface/fonts_mplus_every_skinny.swf" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="GameVersion" value="SkyrimSE" />
          <flagDependency flag="Option-SkyUI-MCMSF" value="True" />
        </dependencies>
        <files>
          <folder source="option/skyui5.2se-mcmspecialfontmap" destination="" />
        </files>
      </pattern>
      <pattern>
        <dependencies operator="And">
          <flagDependency flag="GameVersion" value="Skyrim" />
          <flagDependency flag="Option-SkyUI-MCMSF" value="True" />
        </dependencies>
        <files>
          <folder source="option/skyui5.1-mcmspecialfontmap" destination="" />
        </files>
      </pattern>
    </patterns>
  </conditionalFileInstalls>
</config>